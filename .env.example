# ---- agy-rc: Server Configuration ----
# Listening address. 0.0.0.0 binds to all network interfaces (Tailscale included).
HOST=0.0.0.0
PORT=8787

# Shared authentication token (optional but recommended).
# If set, REST endpoints and WebSockets require `Authorization: Bearer <token>` or `?token=<token>`.
# Generate a secure token with: openssl rand -hex 24
AGY_TOKEN=

# Path or command for the Antigravity CLI (must be in PATH or specify absolute path).
AGY_CMD=agy

# Starting folder for the project picker (only a default: it can browse any readable path).
AGY_PROJECTS_ROOT=/home/username/projects

# Name of the dedicated tmux socket (isolated from your regular tmux sessions).
AGY_TMUX_SOCKET=agyrc

# Directory for local chat and metadata storage.
AGY_DATA_DIR=./data

# Gemini API Key (optional).
# Enables real-time streaming voice transcription with Google's Gemini 3.5 Live model
# (models/gemini-3.5-transcribe-live) and technical vocabulary phonetic correction.
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
